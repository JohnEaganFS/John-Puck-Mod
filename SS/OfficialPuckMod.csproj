<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Libs Include="libs_server\*.dll" Exclude="libs_server\System.*.dll" />

    <Reference Include="@(Libs)">
      <HintPath>%(Libs.FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude legacy/backup source files under og_src from compilation. This keeps them on disk but
       prevents MSBuild from including them as <Compile> items. If you want them visible in IDE
       without building, we re-include them as None. -->
  <ItemGroup>
    <!-- Remove any automatically-included C# files under og_src from compilation -->
    <Compile Remove="og_src\**\*.cs" />

    <!-- Optionally keep the files as non-compiling items so they appear in Solution Explorer -->
    <None Include="og_src\**\*.cs" />
  </ItemGroup>

  <!-- Similarly exclude helper / scratch files under SS from compilation so they remain in the repo but are not built -->
  <ItemGroup>
    <Compile Remove="SS\**\*.cs" />
    <None Include="SS\**\*.cs" />
  </ItemGroup>

  <Target Name="PostBuildMoveDll" AfterTargets="Build">
    <PropertyGroup>
      <TargetDir>J:\Steam\steamapps\common\Puck\Plugins\John's Puck Mod</TargetDir>
      <WorkshopUnstableDir>J:\Downloads\SteamWorkshopUploader\WorkshopContent\John's Official Puck Mod - Unstable</WorkshopUnstableDir>
      <WorkshopDir>J:\Downloads\SteamWorkshopUploader\WorkshopContent\John's Official Puck Mod</WorkshopDir>
    </PropertyGroup>

    <MakeDir Directories="$(TargetDir)" />
    <MakeDir Directories="$(WorkshopDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(WorkshopDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(WorkshopUnstableDir)" OverwriteReadOnlyFiles="true" />

    <Message Importance="high" Text="Copied $(AssemblyName).dll to $(TargetDir), $(WorkshopDir), and $(WorkshopUnstableDir)" />
  </Target>

</Project>