<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Libs Include="libs_server\*.dll" Exclude="libs_server\System.*.dll" />

    <Reference Include="@(Libs)">
      <HintPath>%(Libs.FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude legacy/backup source files under og_src from compilation. Keep them as None so they remain visible in IDE. -->
  <ItemGroup>
    <Compile Remove="og_src\**\*.cs" />
    <None Include="og_src\**\*.cs" />
  </ItemGroup>

  <!-- Exclude helper / scratch files under SS from compilation -->
  <ItemGroup>
    <Compile Remove="SS\**\*.cs" />
    <None Include="SS\**\*.cs" />
  </ItemGroup>

  <Target Name="PostBuildMoveDll" AfterTargets="Build">
    <PropertyGroup>
      <TargetDir>F:\Steam\steamapps\common\Puck\Plugins\John's Relay Mod</TargetDir>
    </PropertyGroup>

    <MakeDir Directories="$(TargetDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />

    <Message Importance="high" Text="Copied $(AssemblyName).dll to $(TargetDir)" />
  </Target>

</Project>
